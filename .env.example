# Valores públicos: nunca incluir secretos, passwords ni credenciales.
# Host de n8n sin /webhook al final. En local, usa Production URL y publica WF.
VITE_N8N_BASE_URL=http://localhost:5678
# Al desplegar Vercel, reemplaza el anterior por https://tu-n8n-publico

# URL completa de producción del Chat Trigger WF10:
VITE_EVENTPASS_CHAT_URL=
# Username del bot sin @:
VITE_TELEGRAM_BOT_USERNAME=

# Personalización opcional de rutas. Vacíos = rutas estándar de los JSON.
VITE_USUARIOS_URL=
VITE_AUTH_URL=
VITE_TELEGRAM_URL=
VITE_CATALOGO_URL=
VITE_INSCRIPCIONES_URL=
# URL de desarrollo del frontend. En local, usa http://localhost:5173
VITE_FRONTEND_URL=http://localhost:5173