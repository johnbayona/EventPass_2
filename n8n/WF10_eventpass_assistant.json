      "id": "6c01ac10-0ab1-40a5-b674-719585c4fb2b",
      "name": "Leer Mensajes",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1200,
        0
      ],
      "alwaysOutputData": true,
      "notes": "Selecciona tu credencial Google Sheets OAuth2. Lectura completa para persistencia académica. Always Output Data permite hojas sin filas."
