    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto=require('crypto');\nconst p=$('Preparar contexto').first().json;\nconst model=$input.first().json;\nconst answer=model.error?'No pude consultar el modelo en este momento. Intenta nuevamente.':String(model.text||model.output||'No tengo información suficiente para responder.');\nconst now=new Date().toISOString();\nconst common={conversation_id:p.conversation_id,usuario_id:'',visitor_id:p.visitor_id};\nconst conversation={...common,fecha_inicio:p.prior?.fecha_inicio||now,fecha_ultima_interaccion:now,estado:'ABIERTA'};\nconst messages=[{...common,message_id:'MSG_'+crypto.randomUUID(),rol:'USER',mensaje:p.input,timestamp:now},{...common,message_id:'MSG_'+crypto.randomUUID(),rol:'ASSISTANT',mensaje:answer,timestamp:new Date(Date.parse(now)+1).toISOString()}];\nreturn [{json:{writes:{Conversaciones:[conversation],Mensajes:messages},notifications:[],status:200,response:{output:answer,conversation_id:p.conversation_id},output:answer}}];\n"
      },
