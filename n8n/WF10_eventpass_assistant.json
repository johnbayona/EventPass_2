    {
      "parameters": {
        "jsCode": "const operationUuid = $('Generar ID operación').first().json.operacion_uuid;\nif (!operationUuid) throw new Error('Falta ID operación');\nlet idCounter = 0;\nconst p=$('Preparar contexto').first().json;\nconst model=$input.first().json;\nconst answer=model.error?'No pude consultar el modelo en este momento. Intenta nuevamente.':String(model.text||model.output||'No tengo información suficiente para responder.');\nconst now=new Date().toISOString();\nconst common={conversation_id:p.conversation_id,usuario_id:'',visitor_id:p.visitor_id};\nconst conversation={...common,fecha_inicio:p.prior?.fecha_inicio||now,fecha_ultima_interaccion:now,estado:'ABIERTA'};\nconst messages=[{...common,message_id:'MSG_'+(operationUuid + '_' + (++idCounter)),rol:'USER',mensaje:p.input,timestamp:now},{...common,message_id:'MSG_'+(operationUuid + '_' + (++idCounter)),rol:'ASSISTANT',mensaje:answer,timestamp:new Date(Date.parse(now)+1).toISOString()}];\nreturn [{json:{writes:{Conversaciones:[conversation],Mensajes:messages},notifications:[],status:200,response:{output:answer,conversation_id:p.conversation_id},output:answer}}];\n"
      },
