      "name": "Modelo IA",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "notes": "Selecciona credencial OpenAI y un modelo disponible en tu cuenta. Puedes reemplazar este subnodo por otro proveedor compatible."
